# 로컬 개발 전용 설정 템플릿
#
# 사용법: 이 파일을 application-local.yml 로 복사하고 비밀번호를 채운다.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# application-local.yml 은 .gitignore 에 있어 커밋되지 않는다.
# application.yml 의 값을 덮어쓰므로 여기 적은 password 가 이긴다.

spring:
  datasource:
    password: 여기에_MySQL_root_비밀번호

  # 로컬 프로파일만 SQL 로그를 켠다 (sp-docs/conventions.md §8)
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    org.hibernate.orm.jdbc.bind: trace

# 서비스 간 내부 API 인증 키. member 와 board 가 같은 값을 써야 한다
# (sp-docs/security.md §6)
member-service:
  internal-api-key: 여기에_내부_API_키

# CORS 허용 오리진. 허용 오리진은 환경이 정하므로 정본에 목록이 없다
# (sp-docs/security.md §1.1). * 는 쓸 수 없다 — 기동이 실패한다.
# 여러 개는 쉼표로 구분한다
cors:
  allowed-origins: http://localhost:3000

# 첨부 저장 루트 (sp-docs/tech-stack.md §4.5). 이미 있고 쓸 수 있는 디렉터리의 경로를 적는다.
# 서버가 만들지 않으므로 먼저 만들어 둔다. 비었거나 없는 경로·파일이면 기동이 실패한다.
# 환경변수 ATTACHMENT_STORAGE_ROOT 가 설정돼 있으면 여기 값보다 앞선다 — 그 이름이 이 키의
# 완화 바인딩 형식(점·대시를 밑줄로 바꾼 대문자)과 같다
attachment:
  storage-root:

# 조회수 판정의 비밀키 (sp-docs/tech-stack.md §4.5, sp-docs/security.md §9). UTF-8 로 32바이트
# 이상인 값을 적는다 — Base64 로 디코드하지 않고 적은 문자열의 바이트를 그대로 쓴다. 비었거나
# 짧으면 기동이 실패한다. 환경변수 VIEW_COUNT_HMAC_SECRET 이 설정돼 있으면 여기 값보다
# 앞선다 — 그 이름이 이 키의 완화 바인딩 형식과 같다
view-count:
  hmac-secret:
